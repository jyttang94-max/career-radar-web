    "institution_category",
    "foundation_field",
    "title",
    "role",
    "duties",
    "requirements",
    "preferred_qualifications",
    "documents",
    "employment",
    "probation_and_conversion",
    "location",
    "salary",
    "published_at",
    "application_start",
    "deadline",
    "deadline_time",
    "selection_schedule",
    "appointment_date",
    "posting_url",
    "verification_status",
    "review_reasons",
    "first_seen_at",
    "last_checked_at"
